{
  "_doc": "tag -> list of rules. Each rule: {pattern: regex (case-insensitive), confidence: high|low, note: optional}. Adding a tag = add an entry here and re-run `python src/tag_dishes.py`. No code edits needed.",
  "snails": [
    {
      "pattern": "\\bsnails?\\b",
      "confidence": "high"
