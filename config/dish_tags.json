      "confidence": "high"
    },
    {
      "pattern": "\\bbraised[^.\\n]{0,50}\\bshort\\s?ribs?\\b",
      "confidence": "high",
      "note": "short rib only when described as braised"
    },
    {
      "pattern": "\\bshort\\s?ribs?\\b[^.\\n]{0,50}\\bbraised\\b",
      "confidence": "high",
      "note": "short rib only when described as braised"
