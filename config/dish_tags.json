    {
      "pattern": "\\braw\\s+tuna\\b",
      "confidence": "high"
    },
    {
      "pattern": "\\bmaguro\\b",
      "confidence": "high",
      "note": "raw tuna on Japanese menus"
    },
    {
      "pattern": "\\b(?:o|chu)[\\s-]?toro\\b",
      "confidence": "high",
      "note": "fatty tuna belly, always raw"
    },
    {
      "pattern": "\\bnegi[\\s-]?toro\\b",
      "confidence": "high"
    },
    {
      "pattern": "\\bakami\\b",
      "confidence": "high",
      "note": "lean tuna, raw"
